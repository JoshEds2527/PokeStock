generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// An Account is a tenant: one login (email + password) that owns an
// isolated set of data. Multiple people can share the same login and
// see the same data (sessions are independent, stateless cookies, so
// there's no single-active-session restriction).
model Account {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  // The developer/admin account: the only one that can manage the shared
  // release catalog, and the only one that can see/remove other accounts.
  isDeveloper   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  lastLoginAt   DateTime?

  products        Product[]
  purchases       Purchase[]
  sales           Sale[]
  createdReleases ReleaseEvent[]
  trackedReleases TrackedRelease[]
  marketListings  MarketListing[]
  stockWatches    StockWatch[]
}

enum ProductCategory {
  BOOSTER_BOX
  ELITE_TRAINER_BOX
  BOOSTER_BUNDLE
  BOOSTER_PACK
  TIN
  SINGLE_CARD
  COLLECTION_BOX
  OTHER
}

model Product {
  id          String            @id @default(cuid())
  account     Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId   String
  name        String
  setName     String?
  category    ProductCategory   @default(OTHER)
  imageUrl    String?
  msrp        Float?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  purchases   Purchase[]
  sales       Sale[]
  watches     StockWatch[]
  listings    MarketListing[]

  @@index([accountId])
}

model Purchase {
  id            String    @id @default(cuid())
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId     String
  quantity      Int
  unitCost      Float
  retailer      String?
  purchaseDate  DateTime  @default(now())
  notes         String?
  createdAt     DateTime  @default(now())

  @@index([accountId])
}

enum SalePlatform {
  EBAY
  VINTED
  FACEBOOK
  DEPOP
  IN_PERSON
  OTHER
}

model Sale {
  id              String        @id @default(cuid())
  account         Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId       String
  quantity        Int
  unitSalePrice   Float
  platform        SalePlatform  @default(OTHER)
  fees            Float         @default(0)
  shippingCost    Float         @default(0)
  saleDate        DateTime      @default(now())
  notes           String?
  createdAt       DateTime      @default(now())

  @@index([accountId])
}

enum ReleaseStatus {
  UPCOMING
  RELEASED
  DELAYED
  CANCELLED
}

// ReleaseEvent is shared/global, not account-scoped: a release date is the
// same fact for everyone. Accounts opt into following one via TrackedRelease.
// Only the account that added an entry may edit or delete it, to stop one
// account's mistakes (or vandalism) from affecting every other account
// tracking the same shared list.
model ReleaseEvent {
  id                  String        @id @default(cuid())
  productName         String
  retailer            String?
  releaseDate         DateTime
  url                 String?
  status              ReleaseStatus @default(UPCOMING)
  notes               String?
  createdByAccount    Account?      @relation(fields: [createdByAccountId], references: [id], onDelete: SetNull)
  createdByAccountId  String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  trackedBy           TrackedRelease[]

  @@index([createdByAccountId])
}

model TrackedRelease {
  id         String       @id @default(cuid())
  account    Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId  String
  release    ReleaseEvent @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  releaseId  String
  createdAt  DateTime     @default(now())

  @@unique([accountId, releaseId])
  @@index([accountId])
}

enum ListingSource {
  EBAY
  VINTED
  OTHER
}

model MarketListing {
  id          String        @id @default(cuid())
  account     Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId   String
  product     Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId   String?
  source      ListingSource
  title       String
  price       Float
  url         String
  sold        Boolean       @default(false)
  listedAt    DateTime?
  fetchedAt   DateTime      @default(now())

  @@index([accountId])
}

enum StockStatus {
  UNKNOWN
  IN_STOCK
  OUT_OF_STOCK
}

model StockWatch {
  id                  String       @id @default(cuid())
  account             Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId           String
  product             Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId           String?
  retailerName        String
  url                 String
  status              StockStatus  @default(UNKNOWN)
  lastCheckedAt       DateTime?
  checkIntervalMinutes Int         @default(30)
  active              Boolean      @default(true)
  createdAt           DateTime     @default(now())

  @@index([accountId])
}
